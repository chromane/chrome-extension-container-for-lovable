{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "paths": {
      "@shared/*": ["./*"]
    },
    "target": "es2021",
    "lib": ["DOM", "ES2015.Core", "DOM.Iterable", "ES2015.Collection", "ES2015.Iterable", "ES2021", "ES2021.String"],
    "module": "ES6",
    "outDir": "./dist_ts",
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["types.d.ts", "./**/*"],
  "exclude": ["node_modules", "dist_ts"]
}
